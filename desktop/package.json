{
  "name": "@recorder/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@recorder/client": "workspace:*",
    "@recorder/contracts": "workspace:*"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "vite": "8.3.5"
  }
}
