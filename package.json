{
  "name": "recorder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "node --import tsx --test backend/test/*.test.ts shared/client/test/*.test.ts",
    "dev:backend": "pnpm --filter @recorder/backend dev",
    "dev:web": "pnpm --filter @recorder/web dev",
    "desktop": "pnpm --filter @recorder/desktop start",
    "check:docs": "node scripts/check-docs.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm check:docs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "@types/node": "24.9.0",
    "@types/better-sqlite3": "9.6.0",
    "esbuild": "0.28.2"
  }
}
